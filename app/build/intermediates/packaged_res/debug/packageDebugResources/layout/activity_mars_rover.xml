<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/space_bg">

    <androidx.appcompat.widget.Toolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="@color/space_surface"
        app:titleTextColor="@color/white" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            <!-- Rover selection -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/label_select_rover"
                android:textColor="@color/white"
                android:textSize="15sp"
                android:textStyle="bold"
                android:layout_marginBottom="10dp" />

            <RadioGroup
                android:id="@+id/radio_group_rover"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="24dp">

                <RadioButton
                    android:id="@+id/radio_curiosity"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/rover_curiosity"
                    android:textColor="@color/white"
                    android:buttonTint="@color/nasa_blue_light" />

                <RadioButton
                    android:id="@+id/radio_opportunity"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/rover_opportunity"
                    android:textColor="@color/white"
                    android:buttonTint="@color/nasa_blue_light" />

                <RadioButton
                    android:id="@+id/radio_spirit"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/rover_spirit"
                    android:textColor="@color/white"
                    android:buttonTint="@color/nasa_blue_light" />

            </RadioGroup>

            <!-- Camera selection -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/label_select_camera"
                android:textColor="@color/white"
                android:textSize="15sp"
                android:textStyle="bold"
                android:layout_marginBottom="8dp" />

            <Spinner
                android:id="@+id/spinner_camera"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:background="@drawable/spinner_background"
                android:popupBackground="@color/space_surface"
                android:layout_marginBottom="24dp" />

            <!-- Sol input -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/label_sol"
                android:textColor="@color/white"
                android:textSize="15sp"
                android:textStyle="bold"
                android:layout_marginBottom="4dp" />

            <TextView
                android:id="@+id/tv_sol_hint"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/text_secondary"
                android:textSize="12sp"
                android:layout_marginBottom="8dp" />

            <EditText
                android:id="@+id/et_sol"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="@string/hint_sol"
                android:inputType="number"
                android:textColor="@color/white"
                android:textColorHint="@color/text_secondary"
                android:backgroundTint="@color/nasa_blue_light"
                android:padding="12dp"
                android:layout_marginBottom="32dp" />

            <!-- Search button -->
            <Button
                android:id="@+id/btn_search"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:text="@string/btn_search"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="@color/white"
                android:backgroundTint="@color/nasa_red" />

        </LinearLayout>
    </ScrollView>

</LinearLayout>
